# Copy to ignored .dev.vars locally; NEVER use live keys or paste real secrets in chat.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
SITE_URL="http://127.0.0.1:8788"

# Approved EUR package amounts: VOID_1=99, VOID_5=349, VOID_10=599, VOID_25=1199 cents.
# Price approval does not activate sales. Keep all runtime flags disabled until release approval.
# Price IDs remain empty; no production Stripe configuration is authorized.
ACCESSORIES_ENABLED="false"
ACCESSORIES_PRICES_APPROVED="false"
ACCESSORIES_STOCK_CONFIRMED="false"
STRIPE_PRICE_ID_VOID_1=""
STRIPE_PRICE_ID_VOID_5=""
STRIPE_PRICE_ID_VOID_10=""
STRIPE_PRICE_ID_VOID_25=""

# Merchant feed remains disabled until reviewed and explicitly published.
MERCHANT_FEED_ENABLED="false"
# legacy: existing sales; paused: stop new 8-Digit sales for cutover; managed: D1 reservations.
# managed requires migration 0005, reconciliation of legacy sessions and confirmed initialization.
SEEDPLATE_STOCK_MODE="legacy"
MERCHANT_SHIPPING_REVIEWED="false"

# Separate setup-only feed. Leave disabled until explicit deployment/import approval.
# DE attests that the Merchant Center data source targets ONLY Germany (not enforced by XML).
MERCHANT_SETUP_FEED_ENABLED="false"
MERCHANT_SETUP_COUNTRY_CONFIRMED=""
