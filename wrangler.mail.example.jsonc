{
  "name": "hodlware-mail-worker",
  "main": "workers/mail-worker.js",
  "compatibility_date": "2026-09-30",
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "COMMUNICATIONS_ENABLED": "false", "MAIL_FROM": "" },
  "d1_databases": [{"binding":"ORDERS","database_name":"hodlware-orders","database_id":"REPLACE_WITH_CONFIRMED_DATABASE_ID"}]
}
